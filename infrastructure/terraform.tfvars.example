# ─────────────────────────────────────────────────────────────────────────────
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in your values before running
# `terraform apply`. The terraform.tfvars file is gitignored by default to
# prevent accidental exposure of environment-specific settings.
#
# Usage:
#   cp terraform.tfvars.example terraform.tfvars
#   # then edit terraform.tfvars with your values
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Deployment ────────────────────────────────────────────────────────────
aws_region = "us-east-1"

# ── Resource Naming ───────────────────────────────────────────────────────────
project_name         = "pilambdachart"
telemetry_table_name = "IoT_Telemetry"
metadata_table_name  = "IoT_Metadata"

# ── Feature Flags ─────────────────────────────────────────────────────────────
enable_point_in_time_recovery = false   # Set to true for staging/prod
enable_metadata_seeding       = true    # Set to false if metadata is managed dynamically out-of-band

# ── CloudFront CDN & Access Protection ─────────────────────────────────────────
enable_cloudfront            = false    # Set to true to deploy CloudFront CDN
enable_cloudfront_basic_auth = true     # Enabled by default when CloudFront is active
basic_auth_username          = "admin"
basic_auth_password          = "pilambdachart2026!"  # Change before deploying!

# Optional Custom Domain & WAF Web ACL (leave empty unless configured)
custom_domain_name  = "" # e.g. "dashboard.example.com"
acm_certificate_arn = "" # e.g. "arn:aws:acm:us-east-1:123456789012:certificate/..."
web_acl_id          = "" # e.g. "arn:aws:wafv2:us-east-1:123456789012:global/webacl/..."

# ── Lambda Function & Automated Schedule ───────────────────────────────────────
enable_lambda           = false               # Set to true after building backend JAR
lambda_memory_size      = 512                 # Memory in MB allocated to Lambda (default: 512)
lambda_schedule_cron    = "rate(5 minutes)"   # Triggers every 5 minutes
lambda_trigger_devices  = [1, 2]              # Device IDs to generate charts for
lambda_trigger_metrics  = [1, 2, 3, 4, 5]     # Metric IDs to generate per device
lambda_trigger_timezone = "America/New_York"  # Target timezone for day calculation




